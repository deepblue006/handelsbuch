{
  "name": "handelsbuch",
  "version": "0.1.0",
  "private": true,
  "description": "Persönliches Investment-Dashboard für Aktien, ETFs und Krypto – Analyse- und Entscheidungshilfe, keine automatische Orderausführung.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:import-snapshot": "tsx scripts/import-snapshot.ts",
    "refresh": "tsx scripts/refresh.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test:integration": "vitest run tests/integration",
    "db:reset-test": "tsx scripts/reset-test-db.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "setup:mac": "bash scripts/setup-mac.sh",
    "live": "bash scripts/start-live.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "next": "16.4.0",
    "papaparse": "5.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.2.1",
    "tailwind-merge": "3.3.1",
    "unpdf": "^1.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
