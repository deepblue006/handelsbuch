# ─────────────────────────────────────────────────────────────────────────────
# Handelsbuch – Umgebungsvariablen. Kopieren nach .env und ausfüllen.
# Echte Schlüssel NIE committen (.env ist in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Datenbank (PostgreSQL). Beispielwerte passen zu docker-compose.yml.
DATABASE_URL="postgresql://handelsbuch:PASSWORT@localhost:5432/handelsbuch?schema=public"
# Separate Testdatenbanken – Name MUSS auf _test enden (werden von Tests geleert)
TEST_DATABASE_URL="postgresql://handelsbuch:PASSWORT@localhost:5432/handelsbuch_test?schema=public"
E2E_DATABASE_URL="postgresql://handelsbuch:PASSWORT@localhost:5432/handelsbuch_test?schema=public"

# Zugriffsschutz (HTTP Basic Auth). Pflicht, sobald das Dashboard nicht nur auf localhost läuft.
DASHBOARD_USER="depot"
DASHBOARD_PASSWORD=""

# ── Kurse, Makro, Termine, Kongressmeldungen (Sekundärquelle) ────────────────
# Alpha Vantage: Free-Key unter https://www.alphavantage.co/support/#api-key
# Free: 25 Anfragen/Tag, 1/s, Tageskurse nur 100 Tage (SMA200 braucht Premium oder andere Quelle)
ALPHAVANTAGE_API_KEY=""
ALPHAVANTAGE_DAILY_LIMIT="25"

# ── Offizielle Makrodaten (H.15-Zinsen, Realzins, Öl, Konsumklima, Schulden, Buffett-Näherung)
# FRED: kostenloser Key unter https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# ── Fundamentaldaten (offiziell, kostenlos): SEC EDGAR verlangt Name + Kontakt im User-Agent
SEC_USER_AGENT=""   # z. B. "Handelsbuch privat dein.name@example.org"

# ── Krypto: CoinGecko Demo-Key (10.000 Credits/Monat, Attribution erforderlich)
COINGECKO_API_KEY=""

# ── Truth Social: nur eine SELBST auf Zulässigkeit geprüfte RSS-Quelle eintragen (kein Scraping)
TRUTHSOCIAL_FEED_URL=""

# ── Vorgesehen, aber (noch) ohne Adapter – Endpunkte erst nach Prüfung der offiziellen Doku
FMP_API_KEY=""
SOSOVALUE_API_KEY=""
DEFILLAMA_PRO_API_KEY=""
CME_FEDWATCH_CLIENT_ID=""
CME_FEDWATCH_CLIENT_SECRET=""

# ── Betrieb
REFRESH_INTERVAL_HOURS="6"
# Hinter einem HTTP(S)-Proxy: Node-fetch nutzt HTTPS_PROXY nur mit dieser Variable
# NODE_USE_ENV_PROXY="1"
